+    private static final Deque<Map<String,Object>> trace = new ArrayDeque<>();
+    public static synchronized void armCapture(int seconds) {
+        if (seconds < 0 || seconds > 120) throw new IllegalArgumentException("Capture 0..120 seconds");
+        trace.clear(); captureUntil = System.currentTimeMillis() + seconds * 1000L;
+    }
+    public static synchronized List<Map<String,Object>> diagnostics() {
+        return new ArrayList<>(trace);
+    }
+    public static void observe(Player player, AbilityInvokeEntry invoke) {
+        if (System.currentTimeMillis() >= captureUntil || player == null || player.getUid() != 10001) return;
+        try {
+            String argument = invoke.getArgumentType().name();
+            boolean relevant = argument.contains("PHLOGISTON");
+            if (argument.endsWith("GLOBAL_FLOAT_VALUE")) {
+                var scalar = AbilityScalarValueEntry.parseFrom(invoke.getAbilityData());
+                relevant = KEY.equals(scalar.getKey().getStr()) || scalar.getKey().getHash() == emu.grasscutter.utils.Utils.abilityHash(KEY);
+            }
+            if (!relevant) return;
+            var row = new LinkedHashMap<String,Object>();
+            row.put("time", java.time.Instant.now().toString()); row.put("argument", argument);
+            row.put("entityId", invoke.getEntityId()); row.put("localId", invoke.getHead().getLocalId());
+            row.put("fuelBefore", player.getPhlogistonValue());
+            row.put("payloadBytes", invoke.getAbilityData().size());
+            row.put("payloadBase64", Base64.getEncoder().encodeToString(invoke.getAbilityData().substring(0, Math.min(256, invoke.getAbilityData().size())).toByteArray()));
+            synchronized (PhlogistonStateHelper.class) { trace.addLast(row); while (trace.size() > 128) trace.removeFirst(); }
+        } catch (Exception ignored) { /* diagnostics never alter the gameplay path */ }
+    }
+    public static boolean acceptSnapshot(Player player, GameEntity source, float value) {
+        if (player == null || source == null || !Float.isFinite(value)) return false;
+        var team = player.getTeamManager();
+        if (team == null) return false;
+        boolean ownTeam = source == team.getEntity();
+        boolean ownAvatar = source instanceof EntityAvatar && team.getActiveTeam().contains(source);
+        if (!ownTeam && !ownAvatar) return false;
+        player.setPhlogistonValue(value);
+        // No echo: the client already owns this absolute snapshot. A second receipt
+        // simply overwrites with the same value, not a second fuel consumption.
+        return true;
+    }
