+package emu.grasscutter.game.ability;
+import com.google.protobuf.*;
+import emu.grasscutter.net.proto.AbilityActionGenerateElemBallOuterClass.AbilityActionGenerateElemBall;
+import emu.grasscutter.net.proto.VectorOuterClass.Vector;
+
+/** Compatibility for observed 7.1 action payloads; legacy fields still take precedence. */
+public final class SkillParticlePacketCompat {
+ private SkillParticlePacketCompat(){}
+ public static AbilityActionGenerateElemBall parse(ByteString bytes)throws InvalidProtocolBufferException {
+  var parsed=AbilityActionGenerateElemBall.parseFrom(bytes);var builder=parsed.toBuilder();
+  // Captured 7.1: pos=11, rot=14. Legacy generated schema: pos=1, rot=7.
+  if(!parsed.hasPos()){var value=vector(parsed,11);if(value!=null)builder.setPos(value);}
+  if(!parsed.hasRot()){var value=vector(parsed,14);if(value!=null)builder.setRot(value);}
+  return builder.build();
+ }
+ private static Vector vector(AbilityActionGenerateElemBall parsed,int field)throws InvalidProtocolBufferException {
+  var values=parsed.getUnknownFields().getField(field).getLengthDelimitedList();
+  if(values.isEmpty())return null;
+  if(values.size()!=1)throw new InvalidProtocolBufferException("Ambiguous skill particle vector field "+field);
+  var value=Vector.parseFrom(values.get(0));
+  if(!Float.isFinite(value.getX())||!Float.isFinite(value.getY())||!Float.isFinite(value.getZ()))
+   throw new InvalidProtocolBufferException("Non-finite skill particle vector field "+field);
+  return value;
+ }
+}
