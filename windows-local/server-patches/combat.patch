+package emu.grasscutter.game.ability;
+
+import emu.grasscutter.data.GameData;
+import emu.grasscutter.game.avatar.Avatar;
+
+/** One effective-level policy for avatar, gadget and serialized ability parameters. */
+public final class SkillLevelResolver {
+    private SkillLevelResolver() {}
+
+    public static int getEffectiveSkillLevel(Avatar avatar, int skillId) {
+        if (avatar == null) return 1;
+        int base = Math.max(1, avatar.getSkillLevelMap().getOrDefault(skillId, 1));
+        var skill = GameData.getAvatarSkillDataMap().get(skillId);
+        if (skill == null || skill.getProudSkillGroupId() <= 0) return base;
+        int group = skill.getProudSkillGroupId();
+        int bonus = avatar.getSkillDepot() == null ? 0 :
+                Math.max(0, avatar.getProudSkillBonusMap().getOrDefault(group, 0));
+        int requested = Math.min(15, base + bonus);
+        // Incomplete or sparse dumps must not turn a valid skill into a missing row.
+        // Only fall back within this group, never into a different skill's data.
+        for (int level = requested; level >= 1; level--) {
+            if (GameData.getProudSkillDataMap().containsKey(group * 100 + level)) return level;
+        }
+        return base;
+    }
+}
